<?xml version="1.0" encoding="UTF-8"?>
<addons>
<addon id="plugin.video.etvkodi" name="ETV otse" version="1.0.3" provider-name="mikklaos">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="inputstream.adaptive" optional="true"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="addon.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.service" library="service.py" start="login"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="et">ETV, ETV2 ja ETV+ otse</summary>
    <summary lang="en">ETV, ETV2 and ETV+ live</summary>
    <description lang="et">ERR-i otsekanalid lehelt otse.err.ee. Osa saateid on ainult Eestis või DRM-iga ja siis ei mängi.</description>
    <description lang="en">ERR live channels from otse.err.ee. Some programmes are limited to Estonia or use DRM and will not play.</description>
    <platform>all</platform>
    <license>GPL-2.0-only</license>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>
<addon id="repository.etvkodi" name="ETV Kodi" version="1.0.0" provider-name="mikklaos">
  <extension point="xbmc.addon.repository" name="ETV Kodi">
    <dir minversion="19.0.0">
      <info compressed="false">https://raw.githubusercontent.com/mikklaos/etv-kodi/master/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/mikklaos/etv-kodi/master/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/mikklaos/etv-kodi/master/zips/</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="et">ETV otseülekande hoidla</summary>
    <summary lang="en">ETV live repository</summary>
    <description lang="et">Hoidla, kust paigaldada ETV, ETV2 ja ETV+ otseplugin.</description>
    <description lang="en">Repository for the ETV, ETV2 and ETV+ live addon.</description>
    <platform>all</platform>
    <license>GPL-2.0-only</license>
    <assets>
      <icon>icon.png</icon>
    </assets>
  </extension>
</addon>
</addons>
